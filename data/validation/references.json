{
  "about": "Published human and cadaver measurements used by scripts/generate_validation.py to write docs/validation.md. Values are as printed in the source, in the source's own sign convention; to_model is the factor (+1 or -1) that converts that convention to the model's. 'approx' marks values read off a figure (about +/-1 mm reading error). spread_kind is SD, SEM, or range.",
  "sources": [
    {"id": "garland_2018", "citation": "Garland AK, Shah DS, Kedgley AE. Wrist tendon moment arms: quantification by imaging and experimental techniques. J Biomech 2018;68:136-140.", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5793998/", "sample": "10 fresh-frozen cadaver arms; tendon excursion on a wrist simulator, forearm mid-prone", "convention": "flexion +, ulnar deviation +", "location": "Table 1, tendon-excursion columns (means over each specimen's range of motion)"},
    {"id": "gonzalez_1997", "citation": "Gonzalez RV, Buchanan TS, Delp SL. How muscle architecture and moment arms affect wrist flexion-extension moments. J Biomech 1997;30:705-712. Plots Brand & Hollister's data.", "url": "https://doi.org/10.1016/S0021-9290(97)00015-8", "sample": "Brand & Hollister cadaver data at neutral; n not stated", "convention": "flexion +, ulnar deviation +", "location": "Fig. 3, read off the figure"},
    {"id": "valero_cuevas_2003", "citation": "Valero-Cuevas FJ, Johanson ME, Towles JD. Towards a realistic biomechanical model of the thumb. J Biomech 2003;36:1019-1030. Table 1 quotes Smutz WP et al. Mechanical advantage of the thumb muscles. J Biomech 1998;31:565-570.", "url": "https://doi.org/10.1016/S0021-9290(03)00061-7", "sample": "Smutz 1998: 7 fresh-frozen cadaver hands (abstract; Wu et al. 2009 says 6)", "convention": "flexion +, abduction +", "location": "Table 1, key-pinch posture (CMC flexion 30 deg, CMC abduction 0 deg, MCP flexion 17 deg)"},
    {"id": "franko_2011", "citation": "Franko OI, Winters TM, Tirrell TF, Hentzen ER, Lieber RL. Moment arms of the human digital flexors. J Biomech 2011;44:1987-1990.", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3124620/", "sample": "6 fresh-frozen cadaver arms; excursion slope over about 0-80 deg with the other joints extended", "convention": "flexion +", "location": "Table 1 (mean +/- SEM)"},
    {"id": "martin_2012", "citation": "Martin JR, Latash ML, Zatsiorsky VM. Effects of the index finger position and force production on the flexor digitorum superficialis moment arms at the metacarpophalangeal joints: a magnetic resonance imaging study. Clin Biomech 2012;27:453-459.", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3328664/", "sample": "10 young men, in vivo MRI, passive", "convention": "flexion +", "location": "Section 3.1"},
    {"id": "an_1983", "citation": "An KN, Ueba Y, Chao EY, Cooney WP, Linscheid RL. Tendon excursion and moment arm of index finger muscles. J Biomech 1983;16:419-425. Values as tabulated by Melzner M, dissertation, Univ. Regensburg 2022 (doi:10.5283/epub.53644), Table 5.2.", "url": "https://doi.org/10.5283/epub.53644", "sample": "7 cadaver hands; means over the range of motion", "convention": "flexion +, adduction (toward the middle finger) +; the adduction sign is inferred from An's convention as printed by Valero-Cuevas et al. 1998", "location": "Melzner 2022, Table 5.2, experimental rows"},
    {"id": "haugstvedt_2001", "citation": "Haugstvedt JR, Berger RA, Berglund LJ. A mechanical study of the moment-forces of the supinators and pronators of the forearm. Acta Orthop Scand 2001;72:629-634.", "url": "https://doi.org/10.1080/000164701317269076", "sample": "8 fresh-frozen arms, elbow at 90 deg; effective moment arm from torque and tendon load", "convention": "pronation -", "location": "Fig. 3, read off the figure at neutral rotation"},
    {"id": "ettema_1998", "citation": "Ettema GJC, Styles G, Kippers V. The moment arms of 23 muscle segments of the upper limb with varying elbow and forearm positions. Hum Mov Sci 1998;17:201-220.", "url": "https://doi.org/10.1016/S0167-9457(97)00030-4", "sample": "3 embalmed cadavers, muscles replaced by strings; mid-prone forearm", "convention": "pronation +", "location": "Table 2, forearm rows (one value per specimen)"},
    {"id": "murray_1995", "citation": "Murray WM, Delp SL, Buchanan TS. Variation of muscle moment arms with elbow and forearm position. J Biomech 1995;28:513-525.", "url": "https://doi.org/10.1016/0021-9290(94)00114-J", "sample": "2 cadavers", "convention": "pronation +", "location": "Results text, p. 520 (cited in the findings, not in the tables)"},
    {"id": "fan_2019", "citation": "Fan S, Cepek J, Symonette C, Ross D, Chinchalkar S, Grant A. Variation of grip strength and wrist range of motion with forearm rotation in healthy young volunteers aged 23 to 30. J Hand Microsurg 2019;11:88.", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6692155/", "sample": "30 adults aged 23-30, dominant side", "convention": "degrees from neutral", "location": "Table 1"},
